# Required for the interactive assistant.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional tracing. Leave either key blank to run without Langfuse.
# Set both keys and the URL for your project to enable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
